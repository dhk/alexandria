# Where this MCP server's own local state (capability token, pidfile,
# installations.toml) lives. When unset, it uses the platform user data
# directory.
ALEXANDRIA_DATA_DIR=./data

# Path to the Alexandria checkout the server reads research/ from. When
# unset, it's detected by walking up from the process's cwd looking for
# docs/DESIGN.md + AGENTS.md. Set this explicitly for a systemd service or
# any process whose cwd isn't the checkout (the "wingman.env" pattern —
# put this in ~/.config/alexandria.env on a server host).
ALEXANDRIA_REPO=

# Extra Host headers the --http transport should accept beyond loopback
# (comma-separated) — the hostname of whatever fronts the loopback port.
ALEXANDRIA_ALLOWED_HOSTS=
