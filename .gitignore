# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.scratch/
dist/

# Local server state (see .env.example) — never version-controlled.
/data/
mcp-http-token
installations-token
mcp-http.pid

# Host deploy artifacts. deploy/install.py unpacks releases into the install
# root and points `current` at the live one, and on this host the install root
# is a checkout of this repository — so 20MB of release bundles land beside the
# corpus, untracked and one `git add -A` away from being committed.
/current
/releases/
/support/
/.tool-pack-root.json

# Exported run bundles. `alexandria-web` writes a ZIP beside the run artifacts
# when a run is exported, and research/<slug>/08-published/ is where they land —
# inside the corpus, untracked, and one `git add -A` away from being committed.
# They are local records rather than authoritative artifacts, and no ZIP has ever
# been committed here; the manifest already records what a run produced.
*.zip

# Editors / OS
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
